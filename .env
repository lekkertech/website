# Local development defaults. This file is committed; production gets its own
# .env written by the deploy workflow, and .dockerignore keeps this one out of
# the image.

# Google's public reCAPTCHA test keys: the verify call always succeeds, so a
# POST with any token redirects. The v3 widget in the browser needs real keys
# with localhost in their allowed domains.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

SLACK_INVITE_URL=https://example.com/slack-invite
