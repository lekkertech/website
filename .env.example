# Every variable the site reads. .env (committed) holds working local
# development defaults; production values are written on the host by the
# deploy workflow from GitHub secrets of the same names.

# reCAPTCHA v3 keys: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Where a verified visitor is redirected
SLACK_INVITE_URL=
